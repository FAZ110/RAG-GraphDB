NEO4J_URI=neo4j+ssc://xxxx.databases.neo4j.io
NEO4J_USER=xxxx
NEO4J_PASSWORD=xxxx

RABBITMQ_URL=...
REDIS_URL=...

LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=local-model

# Encrypts API keys of custom models added in Settings. Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes the stored keys unreadable; they then have to be entered again.
SECRETS_KEY=

LLM_PROVIDER=groq
GROQ_API_KEY=gsk_xxxx
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

DEDUP_ENABLED=true
DEDUP_THRESHOLD=0.75
DEDUP_NAME_MIN_SCORE=0.5
DEDUP_LEXICAL_MIN=0.85
DEDUP_SUGGEST_MIN=0.5
DEDUP_SUGGEST_LEXICAL_MIN=0.8
DEDUP_SUGGEST_ANY_NAME_MIN=0.9
DEDUP_TOP_K=5
