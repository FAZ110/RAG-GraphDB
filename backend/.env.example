NEO4J_URI=neo4j+ssc://xxxx.databases.neo4j.io
NEO4J_USER=xxxx
NEO4J_PASSWORD=xxxx

# Docker Compose reads the passwords below too: docker compose --env-file backend/.env up
# Use long random values, e.g. python -c "import secrets; print(secrets.token_hex(24))"
# (hex, so they need no escaping inside the addresses).
RABBITMQ_USER=atlas
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://atlas:change-me@rabbitmq:5672//
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0

SESSION_TTL_HOURS=168
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API_DOCS=true

# Development only, never on a server: test accounts with one-click sign-in.
# DEV_ACCOUNTS=true
# Development only: users' own models may point at localhost / private addresses (e.g. LM Studio).
# ALLOW_PRIVATE_PROVIDER_URLS=true

LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=local-model

# Encrypts API keys of custom models added in Settings. Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes the stored keys unreadable; they then have to be entered again.
SECRETS_KEY=

LLM_PROVIDER=groq
GROQ_API_KEY=gsk_xxxx
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

DEDUP_ENABLED=true
DEDUP_THRESHOLD=0.75
DEDUP_NAME_MIN_SCORE=0.5
DEDUP_LEXICAL_MIN=0.85
DEDUP_SUGGEST_MIN=0.5
DEDUP_SUGGEST_LEXICAL_MIN=0.8
DEDUP_SUGGEST_ANY_NAME_MIN=0.9
DEDUP_TOP_K=5

# Scaling. The defaults suit a laptop; on a bigger server raise these and nothing else.
# API processes (uvicorn reads WEB_CONCURRENCY); extractions run at once per worker container.
WEB_CONCURRENCY=1
WORKER_CONCURRENCY=2
CUSTOM_WORKER_CONCURRENCY=6
# Extractions per minute with the server's model, shared by all workers: the API key's limit.
SERVER_LLM_PER_MINUTE=10
# The Neo4j container's memory, read by docker-compose.yml.
NEO4J_HEAP=1G
NEO4J_PAGECACHE=512m
NEO4J_POOL_SIZE=100
QUERY_TIMEOUT_SECONDS=30
TASK_QUERY_TIMEOUT_SECONDS=60
